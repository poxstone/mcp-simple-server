{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "mcp_server.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/mcp_server.py",
      "env": {
        "MCP_TRANSPORT": "sse",  // <--# stdio | sse
        "FASTMCP_HOST": "127.0.0.1",  // <--# 127.0.0.1 | ""
        "FASTMCP_PORT": "8080"  // <--# 8080 | ""
      },
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "test_client.py",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/bin/python",
      "program": "${workspaceFolder}/test_client.py",
      "args": [
        "--mcp_host", "https://mcp-simple-server-8326844300.us-central1.run.app",
        "--test_url", "https://eltiempo.com",
      ],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
